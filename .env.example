# App
APP_URL=http://127.0.0.1:3847
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_OIDC_ENABLED=false
NEXT_PUBLIC_ALLOW_DEV_LOGIN=true

# Auth.js (required)
AUTH_SECRET=replace-with-long-random-string
AUTH_URL=http://127.0.0.1:3847
AUTH_ALLOW_DEV_LOGIN=true

# University OIDC (recommended for production)
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPE=openid profile email roles
